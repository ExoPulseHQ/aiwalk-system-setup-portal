#!/usr/bin/env python3
"""exo: the lab machines' side of the vault plugin's "Sync code" page.

    exo code status [--no-fetch] [--repos ExoPulse,NTKCAP,depRL] [repo-path ...]
    exo code diff WORKTREE
    exo code commit WORKTREE --name N --email E -m SUBJECT [--body B] FILE...
    exo code push WORKTREE
    exo code pull WORKTREE        (the main copy, on the trunk: fast-forward only, then its submodules to the commits it pins)
    exo code finish WORKTREE      (merged and clean: removes the worktree and its branch)

    exo train preflight [--runs N] [--config CONFIG.yaml] [--gb-per-run G] [--gpu-gb-per-run G] [--cpus-per-run C]
                        [--margin-gb 4] [--strict-cpu]
    exo train launch CONFIG.yaml LOG --py PYTHON [--repo DIR] [--taskset 16-31] [--memory-max-gb G] [--gb-per-run G]
                     [--foreground] [-- ARGS for deprl.main]
    exo train stop UNIT
    exo train watch RUN_DIR... [--stale-min 30] [--grace-min 20] [--min-free-gb 4] [--since "1 hour ago"]

`train` keeps one training from taking a shared machine down (2026-11-27 horse ran out of memory: two runs, 7 GB of
processes left by trainings that had ended weeks before, and nothing checked or noticed). `preflight` says whether more
runs fit in RAM and GPU memory, counting the growth still ahead of runs already going, and lists idle orphans (it never
kills them: they may be another person's). `launch` runs the preflight, then starts `PYTHON -m deprl.main CONFIG` in a
systemd user scope with MemoryMax (default half the RAM) and no swap, detached, so past its limit the kernel kills that
run only; `stop` stops a scope with all its workers. `watch` reports stale runs, low memory and kernel OOM / Xid lines.
Each prints one JSON object and exits 1 when the answer is no. The vault's training hook sends ssh launches through here.

`status` prints one JSON object describing every git repo in this account: its worktrees, what is changed or unpushed in each,
how far `main` is behind GitHub, and the branches that have no worktree. It only reads; nothing is changed except
`git fetch`. With no paths it looks for repos (a `.git` folder, so not worktrees) up to two levels below $HOME and below each data disk mounted under /media or /mnt;
`--repos` keeps those whose GitHub repo has one of these names (any owner, so a repo not yet moved into the org still counts).
The other commands change one worktree and print {"ok": true, ...}; each checks its own rules (never commit or push the
trunk, never finish a worktree with work not in git) instead of trusting the caller, and refuses with {"ok": false, "error"}.
The plugin runs it over ssh; a person can run it too. Design: vault Project_Management/Code_Repo_Sync_PR_Plugin_Design_Summary.md
"""
import argparse, glob, json, os, re, socket, subprocess, sys, time
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone

VERSION = "4"   # raise by hand when a change here should reach the machines; the app's Machines page compares it
FETCH_TIMEOUT = 15   # seconds per repo; a slow GitHub must not hold the page


def git(repo, *args, timeout=10):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, timeout=timeout)
    return r.stdout.rstrip() if r.returncode == 0 else None   # rstrip: porcelain lines start with a meaningful space


def strip_git(url):   # str.removesuffix needs Python 3.9; ox runs Ubuntu 20.04 with 3.8
    return url[:-4] if url.endswith(".git") else url


def count(repo, *rng):
    n = git(repo, "rev-list", "--count", *rng)
    return int(n) if n is not None else None


def find_repos(home):
    out = []
    for root, dirs, _ in os.walk(home):
        depth = root[len(home):].count(os.sep)
        if ".git" in dirs and os.path.isdir(os.path.join(root, ".git")):
            out.append(root)
        dirs[:] = [d for d in dirs if not d.startswith(".") and d not in ("node_modules", "__pycache__")] if depth < 2 else []
    return sorted(out)


def data_mounts(mounts=None):
    """Mount points of the data disks: where a repo that does not fit under $HOME ends up (tiger's E_drive, goat's disk1)."""
    try:
        with open(mounts or os.environ.get("EXO_MOUNTS", "/proc/mounts")) as f:   # EXO_MOUNTS: the test points it at its own list
            pts = [line.split()[1].replace("\\040", " ") for line in f if len(line.split()) > 1]
    except OSError:
        return []
    return sorted({p for p in pts if p.startswith(("/media/", "/mnt/"))})


def default_branch(repo):
    ref = git(repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if ref:
        return ref.split("/", 1)[1]
    for b in ("main", "master"):   # NTKCAP's trunk is master; never assume main
        if git(repo, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{b}") is not None:
            return b
    return "main"


def worktrees(repo):
    wts, cur = [], {}
    for line in (git(repo, "worktree", "list", "--porcelain") or "").splitlines() + [""]:
        if not line:
            if cur: wts.append(cur)
            cur = {}
        elif line.startswith("worktree "): cur["path"] = line[9:]
        elif line.startswith("HEAD "): cur["head"] = line[5:12]
        elif line.startswith("branch "): cur["branch"] = line[7:][11:] if line[7:].startswith("refs/heads/") else line[7:]
        elif line == "detached": cur["branch"] = None
    return wts


def status(repo, fetch):
    fetched = None
    if fetch:
        try:
            r = subprocess.run(["git", "-C", repo, "fetch", "-q", "--prune", "origin"], capture_output=True, text=True, timeout=FETCH_TIMEOUT)
            fetched = "ok" if r.returncode == 0 else (r.stderr.strip().splitlines() or ["failed"])[-1]
        except subprocess.TimeoutExpired:
            fetched = f"timed out after {FETCH_TIMEOUT} s"
    url = git(repo, "remote", "get-url", "origin") or ""
    dflt = default_branch(repo)
    base = f"origin/{dflt}"
    rows = []
    for i, w in enumerate(worktrees(repo)):
        b = w.get("branch")
        st = [(l[:2], l[3:]) for l in (git(w["path"], "status", "--porcelain=v1", "--untracked-files=normal") or "").splitlines() if len(l) > 3]
        # edits to tracked files are work to upload; new files are often outputs (runs, logs, .so), so they are listed apart, as Sync vault does
        changed, new = [p for x, p in st if x != "??"], [p for x, p in st if x == "??"]
        row = {"path": w["path"], "branch": b, "head": w.get("head"), "main": i == 0, "changed": changed[:50], "changed_count": len(changed), "new": new[:50], "new_count": len(new)}
        if b == dflt:
            row["behind"] = count(w["path"], f"HEAD..{base}")
            row["ahead"] = count(w["path"], f"{base}..HEAD")
        elif b:
            pushed = git(repo, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{b}") is not None
            row["pushed"] = pushed
            row["unpushed"] = count(repo, f"origin/{b}..{b}") if pushed else count(repo, f"{base}..{b}")
            # merged: some commit on the trunk descends from this branch's tip by a merge (squash merges are off)
            row["merged"] = (count(repo, "--merges", "--ancestry-path", f"{b}..{base}") or 0) > 0
            row["author"] = git(repo, "log", "-1", "--format=%an", f"{base}..{b}") or git(repo, "log", "-1", "--format=%an", b)
        rows.append(row)
    with_wt = {r["branch"] for r in rows}
    loose = [b for b in (git(repo, "for-each-ref", "--format=%(refname:short)", "refs/heads") or "").splitlines() if b not in with_wt]
    return {"repo": os.path.basename(repo), "path": repo, "remote": strip_git(url.split(":", 1)[-1]),
            "default": dflt, "fetch": fetched, "worktrees": rows, "no_worktree": loose}


# a login token or key never goes up from here, whatever the caller ticked (same pattern as the vault's Sync)
SECRET = re.compile(r"(^|/)(\.env|[^/]*(token|credential|secret|password|id_rsa|id_ed25519)[^/]*)$", re.I)


class Refuse(Exception):
    pass


def must(repo, *args, timeout=60):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, timeout=timeout)
    if r.returncode:
        raise Refuse(((r.stderr or r.stdout).strip().splitlines() or [f"git {args[0]} failed"])[-1])
    return r.stdout


def where(path):
    """The worktree's repo, branch, trunk and whether it is the repo's main copy."""
    top = git(path, "rev-parse", "--show-toplevel")
    if not top:
        raise Refuse(f"{path} is not inside a git worktree")
    # not --path-format=absolute: git before 2.31 (Ubuntu 20.04) prints the flag back as if it were a path
    common = git(path, "rev-parse", "--git-common-dir")
    repo = os.path.dirname(os.path.abspath(os.path.join(path, common)))
    return repo, git(path, "symbolic-ref", "--short", "-q", "HEAD"), default_branch(repo), os.path.realpath(top) == os.path.realpath(repo), top


def feature(path):
    repo, b, dflt, is_main, top = where(path)
    if not b or b == dflt:
        raise Refuse(f"{top} is on {b or 'a detached commit'}; work on a feature branch in its own worktree")
    return repo, b, dflt, top


def pins(top):
    """{submodule path: checked-out commit, or None when not initialised}, from `git submodule status`."""
    rows = {}
    for l in (git(top, "submodule", "status", "--recursive", timeout=30) or "").splitlines():
        sha, path = l[1:].split()[:2]
        rows[path] = None if l.startswith("-") else sha[:7]
    return rows


def submodules(top):
    """After a pull: each submodule to the commit the superproject now pins (URLs re-read from .gitmodules first, so a
    moved repo is followed). The pull itself already happened, so a submodule that cannot be fetched is reported, not raised."""
    before = pins(top)
    subprocess.run(["git", "-C", top, "submodule", "sync", "-q", "--recursive"], capture_output=True, timeout=30)
    r = subprocess.run(["git", "-C", top, "submodule", "update", "-q", "--init", "--recursive"], capture_output=True, text=True, timeout=600)
    after = pins(top)
    out = {"submodules": {p: {"from": before.get(p), "to": after[p]} for p in after if before.get(p) != after[p]}}
    if r.returncode:
        out["submodule_error"] = ((r.stderr or r.stdout).strip().splitlines() or ["git submodule update failed"])[-1]
    return out


def act(cmd, a):
    if cmd == "diff":
        repo, b, dflt, _, top = where(a.path)
        base = f"origin/{b}" if b and git(repo, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{b}") is not None else f"origin/{dflt}"
        diff = git(top, "diff", "HEAD") or ""
        return {"branch": b, "diff": diff[:60000], "truncated": len(diff) > 60000,
                "new": [l[3:] for l in (git(top, "status", "--porcelain=v1") or "").splitlines() if l.startswith("??")],
                "unpushed": (git(top, "log", "--format=%s", f"{base}..HEAD") or "").splitlines()}
    if cmd == "commit":
        repo, b, _, top = feature(a.path)
        if not a.files:
            raise Refuse("no files ticked")
        bad = [f for f in a.files if SECRET.search(f)]
        if bad:
            raise Refuse(f"looks like a login token or key, not uploaded: {', '.join(bad)}")
        must(top, "add", "-A", "--", *a.files)
        msg = ["-m", a.m] + (["-m", a.body] if a.body else [])
        # ponytail: the author comes from the caller's gh login; once each person signs in with a certificate, take it from EXO_USER instead
        env = {**os.environ, "GIT_AUTHOR_NAME": a.name, "GIT_AUTHOR_EMAIL": a.email, "GIT_COMMITTER_NAME": a.name, "GIT_COMMITTER_EMAIL": a.email}
        r = subprocess.run(["git", "-C", top, "commit", "-q", *msg, "--", *a.files], capture_output=True, text=True, env=env, timeout=60)
        if r.returncode:
            raise Refuse(((r.stderr or r.stdout).strip().splitlines() or ["commit failed"])[-1])
        return {"branch": b, "commit": git(top, "rev-parse", "--short", "HEAD")}
    if cmd == "push":
        repo, b, _, top = feature(a.path)
        must(top, "push", "-q", "-u", "origin", f"HEAD:refs/heads/{b}", timeout=180)
        return {"branch": b}
    if cmd == "pull":
        repo, b, dflt, is_main, top = where(a.path)
        if not is_main or b != dflt:
            raise Refuse(f"bring in updates only on the main copy on {dflt}")
        must(top, "fetch", "-q", "origin", timeout=120)
        before = git(top, "rev-parse", "--short", "HEAD")
        must(top, "merge", "-q", "--ff-only", f"origin/{dflt}")
        out = {"branch": b, "from": before, "to": git(top, "rev-parse", "--short", "HEAD")}
        if os.path.exists(os.path.join(top, ".gitmodules")):
            out.update(submodules(top))
        return out
    if cmd == "finish":
        repo, b, dflt, top = feature(a.path)
        if os.path.realpath(top) == os.path.realpath(repo):
            raise Refuse("the main copy is never removed")
        left = (git(top, "status", "--porcelain=v1") or "").splitlines()
        if left:
            raise Refuse(f"{len(left)} changes are not in git yet; keep or drop them first")
        must(repo, "fetch", "-q", "origin", timeout=120)
        if (count(repo, "--merges", "--ancestry-path", f"{b}..origin/{dflt}") or 0) == 0:
            raise Refuse(f"{b} is not merged into {dflt} on GitHub yet")
        must(repo, "worktree", "remove", top)
        must(repo, "branch", "-D", b)   # -D: merged into origin's trunk was checked above; the local trunk may lag
        return {"branch": b, "removed": top}


# ---- exo train ---------------------------------------------------------------------------------------------------
# RAM of one H2190 VT-MPO run (5 x 40 envs, 1M-transition replay), measured on horse 2026-11-27: the main process and
# each environment worker. Other models give --gb-per-run; the estimate's source is always printed.
MAIN_GB, WORKER_GB = 5.5, 0.35
TRAINING_MARKERS = ("deprl", "multiprocessing.spawn", "multiprocessing.forkserver", "sconegym", "tonic")
STEPS_RE = re.compile(r"[(,\s]steps\s*=\s*(?:int\()?\s*([0-9.eE+_]+)")


def meminfo(path="/proc/meminfo"):
    out = {}
    with open(path) as f:
        for line in f:
            k, v = line.split(":", 1)
            out[k] = int(v.split()[0]) / 1024 / 1024   # GiB
    return out


def gpus():
    """[(index, free_gb, total_gb)]; [] without a working nvidia-smi."""
    try:
        r = subprocess.run(["nvidia-smi", "--query-gpu=index,memory.free,memory.total", "--format=csv,noheader,nounits"],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return []
    rows = []
    for line in (r.stdout.strip().splitlines() if r.returncode == 0 else []):
        try:
            i, free, total = [x.strip() for x in line.split(",")]
            rows.append((int(i), float(free) / 1024, float(total) / 1024))
        except ValueError:   # "[N/A]" or a driver message
            continue
    return rows


def tonic_config(path):
    """(parallel, name) of a deprl training yaml. PyYAML when this python has it; otherwise the two keys are read from
    the `tonic:` block line by line (the system python on a lab machine may have no yaml)."""
    try:
        import yaml
        t = (yaml.safe_load(open(path)) or {}).get("tonic") or {}
        return int(t.get("parallel", 1)), str(t.get("name", "run"))
    except ImportError:
        pass
    parallel, name, inside = 1, "run", False
    for line in open(path):
        if re.match(r"tonic\s*:", line):
            inside = True; continue
        if inside and line.strip() and not line[0].isspace():
            break
        m = re.match(r"\s+(parallel|name)\s*:\s*['\"]?([^'\"#\n]*?)['\"]?\s*(#.*)?$", line) if inside else None
        if m and m.group(1) == "parallel":
            parallel = int(float(m.group(2)))
        elif m:
            name = m.group(2)
    return parallel, name


def per_run_from_config(path):
    """(estimated GB, worker processes + 1) for one run of this training yaml."""
    workers = tonic_config(path)[0]
    return MAIN_GB + WORKER_GB * workers, workers + 1


def _ps(fields):
    try:
        r = subprocess.run(["ps", "-u", str(os.getuid()), "-o", fields], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return []
    return [line.split(None, fields.count(",")) for line in r.stdout.splitlines()]


def _cpu_ticks(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            parts = f.read().rsplit(")", 1)[1].split()
        return int(parts[11]) + int(parts[12])   # utime + stime
    except (OSError, IndexError, ValueError):
        return None


def orphans(min_age_s=86400):
    """This user's idle training processes left behind: python, parent init or the user's systemd (a subreaper under
    desktop sessions), older than a day, no CPU used over one second. [(pid, age_days, rss_gb, cmd)]; never killed here."""
    reapers = {1} | {int(p[0]) for p in _ps("pid=,args=") if len(p) == 2 and p[1].startswith("/lib/systemd/systemd --user")}
    cand = [(int(pid), int(et), int(rss), args) for pid, ppid, et, rss, args in (p for p in _ps("pid=,ppid=,etimes=,rss=,args=") if len(p) == 5)
            if int(ppid) in reapers and "python" in args.split()[0] and int(et) > min_age_s and any(m in args for m in TRAINING_MARKERS)]
    t0 = {pid: _cpu_ticks(pid) for pid, *_ in cand}
    if cand:
        time.sleep(1.0)
    return [(pid, et / 86400, rss / 1024 / 1024, args[:100]) for pid, et, rss, args in cand
            if t0[pid] is not None and _cpu_ticks(pid) == t0[pid]]


def running_growth_gb():
    """RAM this user's running trainings will still take: per process group of a `-m deprl.main CONFIG` process, its
    estimate from CONFIG minus what the group holds now (never negative). Counts a run launched a minute ago, before
    its environments and replay are allocated, so a seed loop cannot start runs faster than memory fills."""
    groups = {}
    for p in _ps("pid=,pgid=,rss=,args="):
        if len(p) < 4:
            continue
        _, pgid, rss, args = p
        g = groups.setdefault(pgid, {"rss": 0, "config": None})
        g["rss"] += int(rss)
        words = args.split()
        if "deprl.main" in words:
            i = words.index("deprl.main")
            if i + 1 < len(words) and words[i + 1].endswith((".yaml", ".yml")) and os.path.exists(words[i + 1]):
                g["config"] = words[i + 1]
    total = 0.0
    for g in groups.values():
        if g["config"]:
            try:
                total += max(0.0, per_run_from_config(g["config"])[0] - g["rss"] / 1024 / 1024)
            except Exception:
                continue
    return total


def check(mem, gpu_rows, load1, ncpu, runs, gb, gpu_gb, cpus, margin_gb, pending_gb=0.0, strict_cpu=False):
    """The decision alone, so it is tested without a machine: (ok, reasons, warnings, numbers). Fits = the new runs'
    RAM is at most half the machine's and at most what is available after the margin and the growth still ahead of
    runs already going, and the GPU with the most free memory has room. CPU oversubscription warns unless strict."""
    need = runs * gb
    total, avail = mem["MemTotal"], mem["MemAvailable"]
    reasons, warnings = [], []
    if need > total / 2:
        reasons.append(f"RAM: {need:.1f} GB for {runs} run(s) is more than half of {total:.1f} GB")
    if need > avail - margin_gb - pending_gb:
        reasons.append(f"RAM: {need:.1f} GB needed, {avail:.1f} GB available, {margin_gb:.0f} GB kept free, "
                       f"{pending_gb:.1f} GB still to come from runs already going")
    best = max(gpu_rows, key=lambda r: r[1]) if gpu_rows else None
    if gpu_gb > 0 and best is not None and runs * gpu_gb > best[1]:
        reasons.append(f"GPU {best[0]}: {runs * gpu_gb:.1f} GB needed, {best[1]:.1f} GB free")
    if load1 + runs * cpus > ncpu:
        (reasons if strict_cpu else warnings).append(f"CPU: load {load1:.1f} + {runs * cpus} worker processes > {ncpu} logical CPUs")
    numbers = {"ram_need_gb": round(need, 1), "ram_total_gb": round(total, 1), "ram_available_gb": round(avail, 1),
               "ram_pending_gb": round(pending_gb, 1), "gpu": None if best is None else {"index": best[0], "free_gb": round(best[1], 1)},
               "load1": round(load1, 2), "cpus": ncpu, "cpu_need": runs * cpus}
    return not reasons, reasons, warnings, numbers


def preflight(runs=1, config=None, gb=None, gpu_gb=1.0, cpus=None, margin_gb=4.0, strict_cpu=False):
    source = "--gb-per-run"
    if config:
        g, c = per_run_from_config(config)
        if gb is None:
            gb, source = g, "H2190 VT-MPO estimate from the config's parallel (give --gb-per-run for other models)"
        cpus = c if cpus is None else cpus
    if gb is None or cpus is None:
        raise Refuse("give --config, or both --gb-per-run and --cpus-per-run")
    ok, reasons, warnings, numbers = check(meminfo(), gpus(), os.getloadavg()[0], os.cpu_count(), runs, gb, gpu_gb, cpus,
                                           margin_gb, running_growth_gb(), strict_cpu)
    orph = orphans()
    return {"ok": ok, "reasons": reasons, "warnings": warnings, "runs": runs, "gb_per_run": round(gb, 2), "gb_source": source,
            **numbers, "orphans": [{"pid": p, "days": round(d, 1), "rss_gb": round(r, 2), "cmd": c} for p, d, r, c in orph],
            "orphans_rss_gb": round(sum(o[2] for o in orph), 1)}


def user_bus_env():
    """This environment with XDG_RUNTIME_DIR set when ssh left it out, so `systemctl --user` finds the user's manager."""
    env = dict(os.environ)
    run = f"/run/user/{os.getuid()}"
    if not env.get("XDG_RUNTIME_DIR") and os.path.isdir(run):
        env["XDG_RUNTIME_DIR"] = run
    return env


def launch(a):
    config = os.path.realpath(os.path.expanduser(a.config))
    if not os.path.isfile(config):
        raise Refuse(f"config not found: {a.config}")
    py = os.path.expanduser(a.py or os.environ.get("PY", ""))
    if not py:
        raise Refuse("give --py: the python of the training's environment, e.g. ~/mambaforge/envs/forward_sim/bin/python")
    repo = os.path.realpath(os.path.expanduser(a.repo or os.getcwd()))
    env = user_bus_env()
    if subprocess.run(["systemctl", "--user", "show-environment"], capture_output=True, env=env, timeout=20).returncode:
        raise Refuse("no systemd --user instance reachable (lingering off, or no user bus); not starting")
    pre = preflight(1, config, a.gb_per_run)
    if not pre["ok"]:
        return {"ok": False, "error": "preflight says no; not starting", "preflight": pre}
    mem_max = a.memory_max_gb if a.memory_max_gb else round(meminfo()["MemTotal"] / 2, 1)
    name = re.sub(r"[^A-Za-z0-9_.-]", "_", tonic_config(config)[1])
    unit = f"deprl-{name}-{datetime.now().strftime('%m%d%H%M%S')}-{os.getpid()}"
    cmd = [py, "-m", "deprl.main", config, *a.args]
    if a.taskset:
        cmd = ["taskset", "-c", a.taskset, *cmd]
    cmd = ["systemd-run", "--user", "--scope", "--quiet", f"--unit={unit}", "-p", f"MemoryMax={mem_max}G", "-p", "MemorySwapMax=0",
           "nice", "-n", "5", *cmd]
    env["PYTHONPATH"] = repo + (":" + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
    log = os.path.abspath(os.path.expanduser(a.log))
    os.makedirs(os.path.dirname(log), exist_ok=True)
    out = {"unit": f"{unit}.scope", "memory_max_gb": mem_max, "log": log, "repo": repo, "stop": f"exo train stop {unit}.scope",
           "warnings": pre["warnings"], "orphans_rss_gb": pre["orphans_rss_gb"]}
    with open(log, "ab") as f:
        if a.foreground:
            code = subprocess.run(cmd, cwd=repo, env=env, stdout=f, stderr=subprocess.STDOUT).returncode
            return {**out, "ok": code == 0, "exit": code}
        # its own session: the run outlives the ssh connection that started it
        p = subprocess.Popen(cmd, cwd=repo, env=env, stdout=f, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    time.sleep(3)
    if p.poll() is not None:
        tail = open(log, errors="replace").read()[-1500:]
        raise Refuse(f"the run ended within 3 s (exit {p.returncode}); log tail:\n{tail}")
    return {**out, "ok": True, "pid": p.pid}


def stop(unit):
    if not re.fullmatch(r"deprl-[A-Za-z0-9_.-]+\.scope", unit):
        raise Refuse("stops only the deprl-*.scope units `exo train launch` started")
    env = user_bus_env()
    r = subprocess.run(["systemctl", "--user", "stop", unit], capture_output=True, text=True, env=env, timeout=120)
    if r.returncode:
        raise Refuse((r.stderr or r.stdout).strip() or f"systemctl stop {unit} failed")
    left = subprocess.run(["systemctl", "--user", "is-active", unit], capture_output=True, text=True, env=env, timeout=20).stdout.strip()
    return {"unit": unit, "state": left or "inactive"}


def run_status(run_dir, stale_min, grace_min=20, now=None):
    """A results directory (~/SCONE/results/<name>): running, stale (newest log.csv older than stale_min), finished
    (last logged step reached the trainer's steps=), starting (young, no log yet) or no-log."""
    now = now or time.time()
    run_dir = os.path.expanduser(run_dir)
    name = os.path.basename(os.path.normpath(run_dir))
    logs = sorted(glob.glob(os.path.join(run_dir, "*", "log.csv")), key=os.path.getmtime)
    if not logs:
        young = os.path.isdir(run_dir) and (now - os.path.getmtime(run_dir)) / 60 < grace_min
        return {"run": name, "state": "starting" if young else "no-log"}
    log = logs[-1]
    age = (now - os.path.getmtime(log)) / 60
    steps = total = None
    try:
        with open(log) as f:
            header, last = f.readline().strip().split(","), None
            for last in f:
                pass
        if last:
            steps = float(dict(zip(header, last.strip().split(","))).get("train/steps", "nan"))
        cfg = os.path.join(os.path.dirname(log), "config.yaml")
        m = STEPS_RE.search(open(cfg).read()) if os.path.exists(cfg) else None
        total = float(m.group(1).replace("_", "")) if m else None
    except (OSError, ValueError):
        pass
    state = "finished" if steps is not None and total is not None and steps >= total else ("stale" if age > stale_min else "running")
    return {"run": name, "state": state, "minutes_since_log": round(age, 1), "steps": steps, "total": total}


def kernel_events(since):
    """Kernel OOM-killer and NVIDIA Xid lines since `since`; None when the journal cannot be read."""
    try:
        r = subprocess.run(["journalctl", "-k", "--no-pager", "-o", "short-iso", "--since", since], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode or re.search(r"No journal files|not seeing messages|permission", r.stderr, re.I):
        return None
    pat = re.compile(r"Out of memory|oom-kill|Killed process|NVRM: Xid")
    return [line[:200] for line in r.stdout.splitlines() if pat.search(line)]


def watch(a):
    runs = [run_status(r, a.stale_min, a.grace_min) for r in a.runs]
    free = meminfo().get("MemAvailable")
    events = kernel_events(a.since)
    alerts = [f"{r['run']}: {r['state']}" for r in runs if r["state"] in ("stale", "no-log")]
    if free is not None and free < a.min_free_gb:
        alerts.append(f"MemAvailable {free:.1f} GB < {a.min_free_gb} GB")
    if events is None:
        alerts.append("kernel: unavailable (cannot read the journal; OOM/Xid not checked)")
    elif events:
        alerts.append(f"{len(events)} kernel OOM/Xid message(s) since {a.since}")
    return {"ok": not alerts, "alerts": alerts, "mem_available_gb": None if free is None else round(free, 1), "runs": runs, "kernel": events}


def train(argv):
    p = argparse.ArgumentParser(prog="exo train")
    sub = p.add_subparsers(dest="cmd")
    pf = sub.add_parser("preflight")
    pf.add_argument("--runs", type=int, default=1); pf.add_argument("--config")
    pf.add_argument("--gb-per-run", type=float); pf.add_argument("--gpu-gb-per-run", type=float, default=1.0)
    pf.add_argument("--cpus-per-run", type=int); pf.add_argument("--margin-gb", type=float, default=4.0)
    pf.add_argument("--strict-cpu", action="store_true")
    la = sub.add_parser("launch")
    la.add_argument("config"); la.add_argument("log"); la.add_argument("--py"); la.add_argument("--repo")
    la.add_argument("--taskset"); la.add_argument("--memory-max-gb", type=float); la.add_argument("--gb-per-run", type=float)
    la.add_argument("--foreground", action="store_true")
    st = sub.add_parser("stop"); st.add_argument("unit")
    wa = sub.add_parser("watch")
    wa.add_argument("runs", nargs="*"); wa.add_argument("--stale-min", type=float, default=30)
    wa.add_argument("--grace-min", type=float, default=20); wa.add_argument("--min-free-gb", type=float, default=4)
    wa.add_argument("--since", default="1 hour ago")
    extra = argv[argv.index("--") + 1:] if "--" in argv else []   # deprl.main's own arguments, after --
    a = p.parse_args(argv[:argv.index("--")] if "--" in argv else argv)
    a.args = extra
    if not a.cmd:
        print(__doc__.strip(), file=sys.stderr); return 2
    try:
        if a.cmd == "preflight":
            out = preflight(a.runs, a.config, a.gb_per_run, a.gpu_gb_per_run, a.cpus_per_run, a.margin_gb, a.strict_cpu)
        elif a.cmd == "launch":
            out = launch(a)
        elif a.cmd == "stop":
            out = {"ok": True, **stop(a.unit)}
        else:
            out = watch(a)
    except (Refuse, subprocess.TimeoutExpired, OSError, ValueError) as e:
        out = {"ok": False, "error": str(e)}
    print(json.dumps({"host": socket.gethostname(), "time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"), **out}, ensure_ascii=False))
    return 0 if out["ok"] else 1


def main(argv):
    if argv[:1] == ["train"]:
        return train(argv[1:])
    if argv[:1] != ["code"] or len(argv) < 2:
        print(__doc__.strip(), file=sys.stderr); return 2
    if argv[1] != "status":
        p = argparse.ArgumentParser(prog=f"exo code {argv[1]}")
        p.add_argument("path")
        if argv[1] == "commit":
            p.add_argument("--name", required=True); p.add_argument("--email", required=True)
            p.add_argument("-m", required=True); p.add_argument("--body", default="")
            p.add_argument("files", nargs="*")
        if argv[1] not in ("diff", "commit", "push", "pull", "finish"):
            print(__doc__.strip(), file=sys.stderr); return 2
        a = p.parse_intermixed_args(argv[2:])   # path, options, then files, in any order
        try:
            print(json.dumps({"ok": True, **act(argv[1], a)}, ensure_ascii=False)); return 0
        except (Refuse, subprocess.TimeoutExpired) as e:
            print(json.dumps({"ok": False, "error": str(e)}, ensure_ascii=False)); return 1
    rest = argv[2:]
    fetch = "--no-fetch" not in rest
    names = next((rest[i + 1] for i, a in enumerate(rest[:-1]) if a == "--repos"), "")
    want = {n.lower() for n in names.split(",") if n}
    paths = [os.path.abspath(os.path.expanduser(p)) for p in rest if not p.startswith("--") and p != names] or sorted({r for top in [os.path.expanduser("~"), *data_mounts()] for r in find_repos(top)})
    if want:   # the remote's last part, so a second clone of the same repo shows up too (and can be flagged)
        paths = [p for p in paths if strip_git((git(p, "remote", "get-url", "origin") or "").rstrip("/")).rsplit("/", 1)[-1].lower() in want]
    with ThreadPoolExecutor(max_workers=8) as ex:
        repos = list(ex.map(lambda p: status(p, fetch), paths))
    print(json.dumps({"host": socket.gethostname(), "user": os.environ.get("USER"), "checked": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                      "repos": repos}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
