#!/bin/bash
# VNC desktops on a lab machine, one at a time, for aIwalk System Setup (run as the desktops' owner, no sudo).
# Every desktop listens on a Unix socket only (~/.vnc/desk-N.sock, mode 600): no TCP port, since only the account
# itself can open the socket, and people reach the account only through SSH via Cloudflare (the portal's Open
# desktop forwards a local port to the socket). Viewers may connect with no password. A fixed one ("aiwalk") is
# offered beside that only because macOS Screen Sharing cannot connect without any; it protects nothing and is not
# a secret: the socket and SSH are the lock.
# Software rendering, as gpu-free-vnc did, so desktops never take GPU memory from training.
#
#   exo-desktop list          displays now running, one per line (":2")
#   exo-desktop start [N]     start display N, or the lowest free one; prints it
#   exo-desktop stop N        stop display N
set -euo pipefail
VERSION=2   # raise by hand when a change here should reach the machines; the app's Machines page compares it
MAX=8   # ponytail: fixed cap per machine, so desktops cannot eat a training run's memory; per-machine setting if needed

# "vncserver -list" prints a table; newer TigerVNC writes the display as "1", older as ":1"
running() { vncserver -list 2>/dev/null | awk '$1 ~ /^:?[0-9]+$/ { sub(/^:/, "", $1); print ":" $1 }' | sort -t: -k2 -n; }

# another X server (the machine's own screen, often :0 to :2) owns that display number
taken() { local all; all=$(ss -xl 2>/dev/null) || true; grep -q "@/tmp/.X11-unix/X$1 " <<<"$all"; }

case "${1:-}" in
  list) running ;;
  start)
    n=${2:-}
    if [ -z "$n" ]; then
      for i in $(seq 1 $MAX); do running | grep -qx ":$i" || taken "$i" || { n=$i; break; }; done
      [ -n "$n" ] || { echo "All $MAX desktops are in use" >&2; exit 1; }
    fi
    [[ "$n" =~ ^[1-9]$ ]] && [ "$n" -le $MAX ] || { echo "Desktop number must be 1 to $MAX" >&2; exit 1; }
    running | grep -qx ":$n" && { echo ":$n"; exit 0; }
    taken "$n" && { echo "Display :$n belongs to another X server on this machine" >&2; exit 1; }
    rm -f "$HOME/.vnc/desk-$n.sock"   # left by a desktop that died or failed to start; vncserver refuses to reuse it
    export LIBGL_ALWAYS_SOFTWARE=1 __GLX_VENDOR_LIBRARY_NAME=mesa GALLIUM_DRIVER=llvmpipe
    sec=None; pass=()
    if command -v vncpasswd >/dev/null 2>&1; then
      [ -s "$HOME/.vnc/desk.pass" ] || ( umask 077; printf 'aiwalk\n' | vncpasswd -f > "$HOME/.vnc/desk.pass" )
      [ -s "$HOME/.vnc/desk.pass" ] && { sec=None,VncAuth; pass=(-PasswordFile "$HOME/.vnc/desk.pass"); }
    fi
    vncserver ":$n" -geometry 1920x1080 -depth 24 -localhost yes -rfbport -1 \
      -rfbunixpath "$HOME/.vnc/desk-$n.sock" -rfbunixmode 0600 -SecurityTypes "$sec" "${pass[@]}" >/dev/null 2>&1
    echo ":$n" ;;
  stop)
    [[ "${2:-}" =~ ^[1-9]$ ]] || { echo "Which desktop? exo-desktop stop N" >&2; exit 1; }
    vncserver -kill ":$2" >/dev/null 2>&1 || { echo "Desktop :$2 was not running" >&2; exit 1; }
    echo "stopped :$2" ;;
  *) sed -n '2,8p' "$0"; exit 1 ;;
esac
