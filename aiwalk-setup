_bundled_hash = None


def bundled_phonedesk_hash():
    """SHA-256 of the Desktop Mode (電腦模式) APK shipped in this folder (to spot an outdated install)."""
    global _bundled_hash
    if _bundled_hash is None:
        import hashlib
        try:
            with open(PHONEDESK_APK, "rb") as f:
                _bundled_hash = hashlib.sha256(f.read()).hexdigest()
        except OSError:
            _bundled_hash = ""
    return _bundled_hash


def adb(serial, *args, stdin=None, timeout=20):
    cmd = [ADB] + (["-s", serial] if serial else []) + list(args)
    try:
        r = subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.replace("\r", "").strip()
    except subprocess.TimeoutExpired:
        return 124, ""


class Phone:
    """Everything the panel shows about one connected phone."""

    def __init__(self, serial):
        self.serial = serial
        self.wireless = ":" in serial
        self.model = serial
        self.ip = serial.split(":")[0] if self.wireless else ""
        self.root = False
        self.desk_native = False   # root phones: desktop is the phone screen itself
        self.phonedesk = False     # 電腦模式 app installed
        self.desk_app_on = False   # 電腦模式 currently showing the desk
        self.shizuku = False
        self.phonedesk_outdated = False  # installed, but differs from the APK in this folder

    @property
    def desk_on(self):
        return self.desk_native if self.root else self.desk_app_on

    def probe(self, root_cache):
        # One round trip for everything that changes; root is cached per serial.
        _, out = adb(self.serial, "shell",
                     f"getprop ro.product.model; getprop {P_FIRST}; "
                     "settings get global overlay_display_devices; "
                     "settings get secure enabled_accessibility_services; "
                     f"pm path {PHONEDESK} >/dev/null 2>&1 && echo yes || echo no; "
                     "pidof shizuku_server >/dev/null && echo yes || echo no; "
                     "ip -4 addr show wlan0 | grep -o 'inet [0-9.]*' | cut -d' ' -f2; "
                     f"sha256sum $(pm path {PHONEDESK} 2>/dev/null | head -1 | cut -d: -f2) 2>/dev/null | cut -c1-64",
                     timeout=8)
        lines = (out.split("\n") + [""] * 8)[:8]
        self.model = lines[0] or self.serial
        self.desk_native = lines[1] == "true"
        self.desk_app_on = lines[2] not in ("", "none", "null") and PHONEDESK in lines[3]
        self.phonedesk = lines[4] == "yes"
        self.shizuku = lines[5] == "yes"
        self.ip = self.ip or lines[6]
        self.phonedesk_outdated = self.phonedesk and bool(lines[7]) and lines[7] != bundled_phonedesk_hash()
        if self.serial not in root_cache:
            code, _ = adb(self.serial, "shell", "su -c true", timeout=5)
            root_cache[self.serial] = code == 0
        self.root = root_cache[self.serial]
        return self


class Silhouette(Gtk.DrawingArea):
    """The phone, drawn in its current state."""

    def __init__(self, phone):
        super().__init__()
        self.phone = phone
        self.set_content_width(96)
        self.set_content_height(112)
        self.set_draw_func(self._draw)
        self.update_property([Gtk.AccessibleProperty.LABEL], [self._describe()])

    def _describe(self):
        mode = "desktop mode" if self.phone.desk_on else "phone mode"
        link = "connected over Wi-Fi" if self.phone.wireless else "connected over USB"
        return f"{self.phone.model}, {mode}, {link}"

    def _draw(self, _area, cr, w, h):
        fg = self.get_color()
        color = DESK_BLUE if self.phone.desk_on else PHONE_GREEN
        cx = w / 2
        if self.phone.desk_on:
            bw, bh = 78, 38          # phone lying sideways, showing a desktop
        else:
            bw, bh = 40, 72          # phone upright
        x, y = cx - bw / 2, 8 + (72 - bh) / 2
        r = 7
        cr.new_sub_path()
        cr.arc(x + bw - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + bw - r, y + bh - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + bh - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()
        cr.set_source_rgba(*color, 0.18)
        cr.fill_preserve()
        cr.set_source_rgb(*color)
        cr.set_line_width(2)
        cr.stroke()
        if self.phone.desk_on:
            # taskbar and two overlapping windows
            cr.set_source_rgb(*color)
            cr.rectangle(x + 3, y + bh - 9, bw - 6, 6)
            cr.fill()
            cr.rectangle(x + 10, y + 7, 26, 16)
            cr.stroke()
            cr.rectangle(x + 30, y + 12, 30, 17)
            cr.fill()
        # connection, drawn under the phone
        base = y + bh
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.7)
        cr.set_line_width(2)
        if self.phone.wireless:
            for i, rad in enumerate((7, 13, 19)):
                cr.arc(cx, 106, rad, -math.pi * 0.75, -math.pi * 0.25)
                cr.stroke()
            cr.arc(cx, 106, 2, 0, 2 * math.pi)
            cr.fill()
        else:
            cr.move_to(cx, base + 2)
            cr.line_to(cx, 110)
            cr.stroke()
            cr.rectangle(cx - 4, base + 2, 8, 6)
            cr.fill()


class AndroidPage(Adw.NavigationPage):
    """Module: phones on this desk (desktop mode, mirroring, keyboard, USB / Wi-Fi)."""

    def __init__(self, toasts):
        super().__init__(title="Android Phone", tag="android")
        self.root_cache = {}
        self.busy = False
        self.signature = None
        self.toasts = toasts

        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Look for phones again")
        refresh.connect("clicked", lambda *_: self.refresh(force=True))
        header.pack_end(refresh)
        view.add_top_bar(header)

        self.stack = Gtk.Stack()
        self.list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24,
                                margin_top=12, margin_bottom=24, margin_start=12, margin_end=12)
        clamp = Adw.Clamp(maximum_size=560, child=self.list_box)
        self.stack.add_named(Gtk.ScrolledWindow(child=clamp, vexpand=True), "phones")

        empty = Adw.StatusPage(icon_name="phone-symbolic", title="No phone found",
                               description="On the phone, turn on USB debugging (Settings › System › Developer options) and connect it with a USB cable. For Wi-Fi, turn on Wireless debugging there instead and keep the phone on the same Wi-Fi as this computer.")
        again = Gtk.Button(label="Reconnect over Wi-Fi", halign=Gtk.Align.CENTER)
        again.add_css_class("pill")
        again.connect("clicked", lambda *_: self.run(self._reconnect_wireless))
        empty.set_child(again)
        self.stack.add_named(empty, "empty")

        self.banner = Adw.Banner(title="A phone is connected but has not allowed debugging. "
                                       "Unlock it and tap Allow on the USB debugging prompt.")
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.append(self.banner)
        content.append(self.stack)
        view.set_content(content)
        self.set_child(view)

        self.refresh(force=True)
        GLib.timeout_add_seconds(4, self._tick)

    # ---------- background work ----------

    def _tick(self):
        self.refresh()
        return True

    def refresh(self, force=False):
        if self.busy and not force:
            return
        threading.Thread(target=self._probe_all, daemon=True).start()

    def _probe_all(self):
        _, out = adb(None, "devices")
        rows = [l.split("\t") for l in out.split("\n")[1:] if "\t" in l]
        serials = [r[0] for r in rows if r[1] == "device"]
        waiting = any(r[1] == "unauthorized" for r in rows)
        phones = [Phone(s).probe(self.root_cache) for s in serials]
        GLib.idle_add(self._show, phones, waiting)

    def run(self, work, *args):
        """Runs an action off the UI thread, then re-probes."""
        self.busy = True

        def job():
            msg = work(*args)
            GLib.idle_add(self._done, msg)

        threading.Thread(target=job, daemon=True).start()

    def _done(self, msg):
        self.busy = False
        if msg:
            self.toasts.add_toast(Adw.Toast(title=msg, timeout=4))
        self.refresh(force=True)

    # ---------- rendering ----------

    def _show(self, phones, waiting=False):
        self.banner.set_revealed(waiting)
        sig = [(p.serial, p.model, p.desk_on, p.root, p.phonedesk, p.phonedesk_outdated, p.shizuku)
               for p in phones]
        if sig == self.signature:
            return
        self.signature = sig
        while (child := self.list_box.get_first_child()) is not None:
            self.list_box.remove(child)
        self.stack.set_visible_child_name("phones" if phones else "empty")
        for p in phones:
            self.list_box.append(self._phone_section(p))

    def _phone_section(self, p):
        section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        head = Gtk.Box(spacing=16)
        head.append(Silhouette(p))
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, valign=Gtk.Align.CENTER, hexpand=True)
        name = Gtk.Label(label=p.model, xalign=0)
        name.add_css_class("title-2")
        text.append(name)
        link = f"Connected over Wi-Fi, {p.ip}" if p.wireless else "Connected over USB"
        text.append(self._dim(link))
        if p.desk_on:
            state = "Desktop is on" + ("" if p.root else " (Desktop Mode app)")
        else:
            state = "Phone mode"
        text.append(self._dim(state + (", rooted" if p.root else "")))
        head.append(text)
        section.append(head)

        rows = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        rows.add_css_class("boxed-list")
        rows.append(self._action("Type with this keyboard", "Use this computer's keyboard and touchpad on the phone",
                                 "input-keyboard-symbolic", self._keyboard, p))
        rows.append(self._action("Show the phone screen here", "Mirror it and control it with the mouse",
                                 "video-display-symbolic", self._mirror, p))
        rows.append(self._desk_row(p))
        if p.wireless:
            rows.append(self._action("Disconnect Wi-Fi", None, "network-wireless-offline-symbolic",
                                     self._disconnect, p))
        else:
            rows.append(self._action("Switch to Wi-Fi", "Then you can unplug the USB cable",
                                     "network-wireless-symbolic", self._go_wireless, p))
        section.append(rows)
        return section

    @staticmethod
    def _dim(text):
        label = Gtk.Label(label=text, xalign=0, wrap=True)
        label.add_css_class("dim-label")
        return label

    def _action(self, title, subtitle, icon, handler, p):
        row = Adw.ActionRow(title=title, activatable=True)
        if subtitle:
            row.set_subtitle(subtitle)
        row.add_prefix(Gtk.Image(icon_name=icon))
        row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        row.connect("activated", lambda *_: handler(p))
        return row

    def _desk_row(self, p):
        if not p.root and not p.phonedesk:
            row = Adw.ActionRow(title="Desktop", subtitle="Not rooted: install the Desktop Mode app first (keeps all data)")
            row.add_prefix(Gtk.Image(icon_name="computer-symbolic"))
            install = Gtk.Button(label="Install", valign=Gtk.Align.CENTER)
            install.add_css_class("suggested-action")
            install.connect("clicked", lambda *_: self.run(self._install_phonedesk, p))
            row.add_suffix(install)
            return row
        if p.root:
            sub = "Built-in setting, applies after a restart"
        elif not p.shizuku:
            sub = "Shizuku is not running; it will be started first"
        else:
            sub = "Shown on the phone screen by the Desktop Mode app"
        if not p.root and p.phonedesk_outdated:
            sub = "The Desktop Mode app on this phone is outdated, update it first"
        row = Adw.SwitchRow(title="Desktop", subtitle=sub, active=p.desk_on)
        row.add_prefix(Gtk.Image(icon_name="computer-symbolic"))
        if not p.root and p.phonedesk_outdated:
            update = Gtk.Button(label="Update", valign=Gtk.Align.CENTER)
            update.add_css_class("suggested-action")
            update.connect("clicked", lambda *_: self.run(self._install_phonedesk, p))
            row.add_suffix(update)
        row.connect("notify::active", lambda r, _: self._toggle_desk(p, r.get_active()))
        return row

    # ---------- actions ----------

    def _keyboard(self, p):
        self._scrcpy(p, ["--no-video", "--no-audio", "--keyboard=uhid", "--mouse=uhid",
                         "--window-title=Phone keyboard"])
        self.toasts.add_toast(Adw.Toast(title="Click the Phone keyboard window, then type", timeout=4))

    def _mirror(self, p):
        self._scrcpy(p, ["--keyboard=uhid", f"--window-title={p.model}"])

    @staticmethod
    def _scrcpy(p, args):
        # Group scrcpy's windows under this app in the dock and show our icon inside them.
        env = dict(os.environ, ADB=ADB, SCRCPY_ICON_PATH=os.path.join(HERE, "icon.png"),
                   SDL_APP_ID=APP_ID, SDL_VIDEO_WAYLAND_WMCLASS=APP_ID, SDL_VIDEO_X11_WMCLASS=APP_ID)
        subprocess.Popen([SCRCPY, "-s", p.serial] + args, env=env,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    def _toggle_desk(self, p, on):
        if on == p.desk_on:
            return
        if p.root:
            dialog = Adw.AlertDialog(
                heading=("Turn on" if on else "Turn off") + f" the desktop on {p.model}?",
                body="This applies the whole setup (display size, font size, landscape). It takes effect after a restart.")
            dialog.add_response("cancel", "Cancel")
            dialog.add_response("later", "Restart later")
            dialog.add_response("reboot", "Apply and restart")
            dialog.set_response_appearance("reboot", Adw.ResponseAppearance.SUGGESTED)

            def answered(_d, response):
                if response == "cancel":
                    self.signature = None  # redraw to put the switch back
                    self.refresh(force=True)
                else:
                    self.run(self._root_desk, p, on, response == "reboot")

            dialog.connect("response", answered)
            dialog.present(self)
        else:
            self.run(self._app_desk, p, on)

    def _root_desk(self, p, on, reboot):
        adb(p.serial, "shell", "su", stdin=ROOT_ON if on else ROOT_OFF, timeout=30)
        # drop only 電腦模式's accessibility entry, keep any other services
        adb(p.serial, "shell", 'v=$(settings get secure enabled_accessibility_services); '
            'n=$(echo "$v" | tr ":" "\\n" | grep -v "^com.eddlai.phonedesk/" | paste -sd:); '
            '[ "$v" != "$n" ] && settings put secure enabled_accessibility_services "$n"')
        if reboot:
            adb(p.serial, "reboot")
            return f"{p.model} is restarting"
        return "Applied, takes effect after a restart"

    def _start_shizuku(self, p):
        _, path = adb(p.serial, "shell", "pm path moe.shizuku.privileged.api")
        lib = path.replace("package:", "").replace("base.apk", "lib/arm64/libshizuku.so")
        adb(p.serial, "shell", lib, timeout=60)

    def _app_desk(self, p, on):
        if on and not p.shizuku:
            self._start_shizuku(p)
        # Launching 電腦模式 enters the desk; launching it again while the desk runs exits.
        adb(p.serial, "shell", f"am start -n {PHONEDESK}/.MainActivity")
        return "Turning on the desktop, check the phone" if on else "Back to phone mode"

    def _install_phonedesk(self, p):
        if not os.path.exists(PHONEDESK_APK):
            return "The Desktop Mode app installer is missing from this folder"
        code, _ = adb(p.serial, "shell", "pm path moe.shizuku.privileged.api")
        if code != 0 and adb(p.serial, "install", SHIZUKU_APK, timeout=180)[0] != 0:
            return "Could not install Shizuku"
        if p.desk_app_on:  # updating kills the running desk; leave it cleanly first
            adb(p.serial, "shell", f"am start -n {PHONEDESK}/.MainActivity")
            GLib.usleep(3_000_000)
        if adb(p.serial, "install", "-r", PHONEDESK_APK, timeout=180)[0] != 0:
            return "Could not install the Desktop Mode app"
        adb(p.serial, "shell", f"pm enable {PHONEDESK}")
        self._start_shizuku(p)
        return f"Desktop Mode app installed on {p.model}. Allow Shizuku on the phone the first time you use it."

    def _go_wireless(self, p):
        if not p.ip:
            return "The phone is not on Wi-Fi"
        adb(p.serial, "tcpip", "5555")
        os.makedirs(os.path.dirname(IPFILE), exist_ok=True)
        with open(IPFILE, "w") as f:
            f.write(p.ip)
        GLib.usleep(2_000_000)
        _, out = adb(None, "connect", f"{p.ip}:5555")
        return "Now on Wi-Fi, you can unplug the cable" if "connected" in out else f"Could not connect over Wi-Fi: {out}"

    def _disconnect(self, p):
        adb(None, "disconnect", p.serial)
        return "Wi-Fi disconnected"

    def _reconnect_wireless(self):
        # Wireless-debugging phones advertise themselves; fall back to the last saved IP.
        _, out = adb(None, "mdns", "services")
        targets = [l.split()[-1] for l in out.split("\n") if "_adb-tls-connect" in l]
        if not targets and os.path.exists(IPFILE):
            targets = [open(IPFILE).read().strip() + ":5555"]
        connected = [t for t in targets if "connected" in adb(None, "connect", t)[1]]
        return f"Connected {len(connected)} phone(s)" if connected else "No phone found on Wi-Fi"


# ---------------------------------------------------------------- Windows VM

CARD_READER = ("0x0ca6", "0x0010")  # Castles EZUSB PC/SC (health-insurance / citizen certificate cards)
CARD_ARG = f'-device usb-host,bus=xhci.0,vendorid={CARD_READER[0]},productid={CARD_READER[1]}'
SECRET_SCHEMA = None


def secret_schema():
    global SECRET_SCHEMA
    if SECRET_SCHEMA is None:
        gi.require_version("Secret", "1")
        from gi.repository import Secret
        SECRET_SCHEMA = Secret.Schema.new(f"{APP_ID}.WindowsVM", Secret.SchemaFlags.NONE,
                                          {"user": Secret.SchemaAttributeType.STRING})
    return SECRET_SCHEMA


def load_password(user):
    schema = secret_schema()
    from gi.repository import Secret
    return Secret.password_lookup_sync(schema, {"user": user}, None)


def save_password(user, password):
    schema = secret_schema()
    from gi.repository import Secret
    Secret.password_store_sync(schema, {"user": user}, Secret.COLLECTION_DEFAULT,
                               f"Windows VM ({user})", password, None)


def sh(*cmd, timeout=180):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        return 1, str(e)


class WindowsVm:
    """A dockur/windows VM found on this computer, described by its compose file."""

    def __init__(self, name, state, compose):
        self.name, self.state, self.compose = name, state, compose
        text = open(compose).read() if compose and os.path.exists(compose) else ""
        self.text = text

        def env(key, default=""):
            for line in text.splitlines():
                t = line.strip()
                if t.startswith(f"{key}:"):
                    return t.split(":", 1)[1].split("#")[0].strip().strip('"')
            return default

        self.ram, self.cpus, self.disk = env("RAM_SIZE", "?"), env("CPU_CORES", "?"), env("DISK_SIZE", "?")
        self.user = env("USERNAME", "Docker")
        self.card_reader = any(l.strip().startswith("ARGUMENTS:") and CARD_READER[0] in l
                               for l in text.splitlines())
        # host port mapped to Windows' RDP 3389, e.g. - "13389:3389/tcp"  # comment
        import re
        m = re.search(r'^\s*-\s*"?(\d+):3389(?:/tcp)?"?', text, re.M)
        self.rdp_port = m.group(1) if m else "3389"
        m = re.search(r'^\s*-\s*"?([^:"\s]+):/storage', text, re.M)
        self.storage = m.group(1) if m else os.path.join(os.path.dirname(compose or ""), "storage")
        # host folder Windows sees as \\host.lan\Data; also shared in the RDP window as \\tsclient\<name>
        m = re.search(r'^\s*-\s*"?([^:"\s]+):/(?:data|shared)\b', text, re.M)
        self.share = m.group(1) if m else None

    # The aIwalk helper: a SYSTEM task in Windows (windows/agent.ps1) that runs fixed jobs by name.
    # We talk to it through <share>/.aiwalk: it touches "alive", we write "request", it writes "result.txt".

    def helper_dir(self):
        return os.path.join(self.share, ".aiwalk") if self.share else None

    def stage_helper(self):
        """Puts the helper's scripts where Windows' one-time setup copies them from."""
        os.makedirs(self.helper_dir(), exist_ok=True)
        for name in ("agent.ps1", "install-agent.ps1", "cleanup.ps1"):
            shutil.copy(os.path.join(HERE, "windows", name), self.helper_dir())

    def wait_helper(self, seconds):
        alive = os.path.join(self.helper_dir(), "alive")
        for _ in range(0, seconds, 5):
            try:
                if time.time() - os.path.getmtime(alive) < 30:
                    return True
            except OSError:
                pass
            time.sleep(5)
        return False

    def run_job(self, name, on_step=None, minutes=60):
        """Asks the helper to run a job and waits for its output; returns a one-line message.
        on_step(text) gets each step the job reports, e.g. "8/9 WinSxS component cleanup"."""
        result = os.path.join(self.helper_dir(), "result.txt")
        progress = os.path.join(self.helper_dir(), "progress")
        for old in (result, progress):
            if os.path.exists(old):
                os.remove(old)
        with open(os.path.join(self.helper_dir(), "request"), "w") as f:
            f.write(name)
        for _ in range(minutes * 20):
            time.sleep(3)
            if on_step and os.path.exists(progress):
                on_step(open(progress, encoding="utf-8-sig", errors="replace").read().strip())
            if os.path.exists(result):
                out = open(result, encoding="utf-8-sig", errors="replace").read()
                after = next((l.strip() for l in out.splitlines() if l.startswith("AFTER")), "")
                used = self.disk_used_gb()
                return (f"Cleanup finished. Windows C: {' '.join(after.split()[1:])}" if after
                        else "Cleanup finished") + (f". The disk now takes {used:.0f} GB here." if used else "")
        return "Windows did not finish the cleanup within an hour"

    def drives(self):
        """RDP drive redirections: the VM's shared folder plus name=path lines from DRIVES_FILE."""
        found = {os.path.basename(self.share.rstrip("/")): self.share} if self.share else {}
        if os.path.exists(DRIVES_FILE):
            for line in open(DRIVES_FILE):
                name, _, path = line.strip().partition("=")
                if name and path and not name.startswith("#"):
                    found[name.strip()] = os.path.expanduser(path.strip())
        return [f"/drive:{n},{p}" for n, p in found.items() if os.path.isdir(p)]

    def disk_used_gb(self):
        """Space the sparse disk image really takes on this computer."""
        img = os.path.join(self.storage, "data.img")
        return os.stat(img).st_blocks * 512 / 2**30 if os.path.exists(img) else None

    def set_env(self, values):
        """Rewrites KEY: "value" lines in the compose file, keeping their comments."""
        out = []
        for line in self.text.splitlines():
            key = line.strip().split(":", 1)[0]
            if key in values and not line.strip().startswith("#"):
                head, _, rest = line.partition(":")
                comment = rest[rest.index("#"):] if "#" in rest else ""
                line = f'{head}: "{values[key]}"' + (f"  {comment}" if comment else "")
            out.append(line)
        self.text = "\n".join(out) + "\n"
        with open(self.compose, "w") as f:
            f.write(self.text)
        return self.recreate()

    def recreate(self):
        return sh("docker", "compose", "-f", self.compose, "create", "--force-recreate")

    @property
    def running(self):
        return self.state == "running"

    @staticmethod
    def find():
        code, out = sh("docker", "ps", "-a", "--filter", "ancestor=dockurr/windows", "--format",
                       '{{.Names}}|{{.State}}|{{.Label "com.docker.compose.project.config_files"}}', timeout=15)
        if code != 0 or not out:
            return None
        name, state, compose = (out.splitlines()[0].split("|") + ["", ""])[:3]
        return WindowsVm(name, state, compose.split(",")[0])

    def set_card_reader(self, on):
        """Adds or comments out the USB passthrough; applied by recreating the (stopped) container."""
        lines, out, done = self.text.splitlines(), [], False
        for line in lines:
            t = line.strip()
            if CARD_READER[0] in t and t.lstrip("# ").startswith("ARGUMENTS:"):
                indent = line[:len(line) - len(line.lstrip())]
                body = t.lstrip("# ")
                out.append(indent + (body if on else "# " + body))
                done = True
            else:
                out.append(line)
        if on and not done:
            i = next(i for i, l in enumerate(out) if l.strip() == "environment:")
            out.insert(i + 1, f'      ARGUMENTS: "{CARD_ARG}"')
            if not any("/dev/bus/usb" in l for l in out):
                j = next(i for i, l in enumerate(out) if l.strip() == "devices:")
                out.insert(j + 1, "      - /dev/bus/usb")
        with open(self.compose, "w") as f:
            f.write("\n".join(out) + "\n")
        return self.recreate()


class WindowsVmPage(Adw.NavigationPage):
