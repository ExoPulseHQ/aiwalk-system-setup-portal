        super().__init__(application=app, title="aIwalk System Setup")
        self.set_default_size(960, 680)
        toasts = Adw.ToastOverlay()
        split = Adw.NavigationSplitView()
        self.pages = [make(toasts) for make, _ in MODULES]

        sidebar_list = Gtk.ListBox()
        sidebar_list.add_css_class("navigation-sidebar")
        for page, (_, icon) in zip(self.pages, MODULES):
            row = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6, margin_start=6)
            row.append(Gtk.Image(icon_name=icon))
            row.append(Gtk.Label(label=page.get_title(), xalign=0))
            sidebar_list.append(row)
        def show(_list, row):
            if row and split.get_content() is not self.pages[row.get_index()]:
                split.set_content(self.pages[row.get_index()])

        sidebar_list.connect("row-selected", show)

        side_view = Adw.ToolbarView()
        side_view.add_top_bar(Adw.HeaderBar())
        side_view.set_content(sidebar_list)
        split.set_sidebar(Adw.NavigationPage(title="aIwalk System Setup", child=side_view))
        split.set_content(self.pages[0])
        sidebar_list.select_row(sidebar_list.get_row_at_index(0))

        toasts.set_child(split)
        self.set_content(toasts)


