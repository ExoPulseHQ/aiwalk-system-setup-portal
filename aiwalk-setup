def gh_auth_accounts():
    """github.com accounts gh auth is signed in to, parsed from `gh auth status`:
    [{"login", "active", "protocol", "token" (masked, prefix tells the kind), "scopes"}]."""
    _code, out = sh("gh", "auth", "status", "--hostname", "github.com", timeout=15)
    accounts = []
    for line in out.splitlines():
        m = re.search(r"Logged in to github\.com account (\S+)", line)
        if m:
            accounts.append({"login": m.group(1), "active": False, "protocol": "", "token": "", "scopes": []})
            continue
        if not accounts:
            continue
        key, _, value = line.strip().lstrip("- ").partition(": ")
        if key == "Active account":
            accounts[-1]["active"] = value == "true"
        elif key == "Git operations protocol":
            accounts[-1]["protocol"] = value
        elif key == "Token":
            accounts[-1]["token"] = value
        elif key == "Token scopes":
            accounts[-1]["scopes"] = re.findall(r"'([^']+)'", value)
    return accounts


