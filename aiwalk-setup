    def _set_up_key(self, user, scopes):
        info = fido_info()
        if info is None:
            self.toasts.add_toast(Adw.Toast(title="Plug in the security key first", timeout=4))
            return
        has_pin, min_len = info
        first, again = Gtk.PasswordEntry(show_peek_icon=True), Gtk.PasswordEntry(show_peek_icon=True)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.append(first)
        if not has_pin:
            first.set_property("placeholder-text", f"New PIN, at least {min_len} characters")
            again.set_property("placeholder-text", "The same PIN again")
            box.append(again)
        dialog = Adw.AlertDialog(
            heading="Set up the security key" if has_pin else "Give the key a PIN",
            body="Enter the key's PIN. Then touch the key when it blinks." if has_pin else
                 "The key has no PIN yet, so anyone holding it could use it. The PIN stays on the key; "
                 "5 wrong tries in a row lock it. Then touch the key when it blinks.")
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Continue")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            pin = first.get_text()
            if response != "go":
                return
            if not has_pin and (pin != again.get_text() or len(pin) < min_len):
                self.toasts.add_toast(Adw.Toast(title=f"The PINs must match and have at least {min_len} "
                                                      "characters", timeout=5))
                return
            wait = Adw.AlertDialog(heading="Touch your security key",
                                   body="Touch the key when it blinks. This takes up to a minute.")
            wait.present(self)

            def work():
                try:
                    if not has_pin:
                        fido_set_pin(pin)
                    error = create_key(user, pin)
                except Exception as e:  # device errors come as many types; show them, never crash the page
                    error = f"The key refused: {e}"
                GLib.idle_add(wait.force_close)
                if error:
                    return error
                missing = [s for s in KEY_SCOPES if s not in scopes]
                if missing:
                    # gh auth has to be allowed to add keys first; same browser approval as signing in
                    GLib.idle_add(self._gh_device, ["gh", "auth", "refresh", "--hostname", "github.com",
                                                    "--scopes", ",".join(missing)],
                                  "Allow adding the key to GitHub",
                                  lambda ok: self.run(register_key) if ok else
                                  self._done("GitHub did not allow adding the key"))
                    return None
                return register_key()

            self.run(work)

        dialog.connect("response", answered)
        dialog.present(self)

    @staticmethod
    def _tree_rows(user, v):
        """Rows for a vault's expander: an optional View as picker, then the tree of its repos."""
        people, tree, org = v["people"], v["tree"], v["org"]
        frame = Gtk.Frame(margin_top=6, margin_bottom=6, margin_start=6, margin_end=6)
        frame.add_css_class("card")
        rows = []
        if user in people and people[user][1] is None:
            # owners may preview any member's view
            logins = sorted(people, key=lambda l: (l != user, people[l][0].lower()))
            view_as = Adw.ComboRow(title="View as", model=Gtk.StringList.new(
                [f"{people[l][0]} ({l})" if people[l][0] != l else l for l in logins]))
            view_as.connect("notify::selected", lambda r, _: frame.set_child(
                access_tree(tree, people[logins[r.get_selected()]][1], org)))
            rows.append(view_as)
        frame.set_child(access_tree(tree, people.get(user, (None, {}))[1], org))
        return rows + [frame]

    def _sign_in(self):
        def signed_in(ok):
            if ok:
                sh("gh", "auth", "setup-git")
            self._done("Signed in" if ok else "Sign-in was not completed")

        self._gh_device(["gh", "auth", "login", "--hostname", "github.com", "--git-protocol", "https", "--web"],
                        "Sign in with GitHub", signed_in)

    def _gh_device(self, command, heading, then):
        """Runs a gh auth browser flow: shows its one-time code, then calls then(ok) on the main thread."""
        proc = subprocess.Popen(command,
                                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        dialog = Adw.AlertDialog(heading=heading, body="Waiting for GitHub…")
        dialog.add_response("cancel", "Cancel")
        dialog.connect("response", lambda *_: proc.poll() is None and proc.terminate())
        dialog.present(self)

        def read():
            import re
            for line in proc.stdout:
                m = re.search(r"code: ([A-Z0-9]{4}-[A-Z0-9]{4})", line)
                if m:
                    GLib.idle_add(self._show_code, dialog, m.group(1))
                if "Press Enter" in line:
                    proc.stdin.write("\n")
                    proc.stdin.flush()
            ok = proc.wait() == 0
            GLib.idle_add(dialog.close)
            GLib.idle_add(then, ok)

        threading.Thread(target=read, daemon=True).start()

    def _show_code(self, dialog, code):
        self.get_display().get_clipboard().set(code)
        dialog.set_body(f"Your one-time code is\n\n{code}\n\nIt is copied. Paste it on the GitHub page that "
                        "just opened in your browser and approve.")

    def _sign_out(self):
        dialog = Adw.AlertDialog(heading="Sign out of GitHub?",
                                 body="This computer loses access to the company repositories "
                                      "until you sign in again.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("out", "Sign out")
        dialog.set_response_appearance("out", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", lambda _d, r: r == "out" and self.run(
            lambda: "Signed out" if sh("gh", "auth", "logout", "--hostname", "github.com")[0] == 0
            else "Could not sign out"))
        dialog.present(self)


