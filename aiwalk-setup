    def refresh(self):
        if self.busy:
            return
        threading.Thread(target=lambda: GLib.idle_add(self._show, WindowsVm.find()), daemon=True).start()

    def run(self, work, *args):
        self.busy = True

        def job():
            msg = work(*args)
            GLib.idle_add(self._done, msg)

        threading.Thread(target=job, daemon=True).start()

    def _done(self, msg):
        self.busy = False
        if msg:
            self.toasts.add_toast(Adw.Toast(title=msg, timeout=5))
        self.signature = None
        self.refresh()

