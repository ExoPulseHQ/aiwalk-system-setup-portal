        super().__init__(title="Windows VM", tag="windows")
        self.toasts = toasts
        self.vm = None
        self.busy = False
        self.signature = None
        self.cleaning = None  # (step text, when it started) while Clean up runs
        self.clean_row = self.clean_bar = None
        GLib.timeout_add_seconds(2, self._tick_progress)

        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Check the VM again")
        refresh.connect("clicked", lambda *_: self.refresh())
        header.pack_end(refresh)
        view.add_top_bar(header)
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24,
                            margin_top=12, margin_bottom=24, margin_start=12, margin_end=12)
