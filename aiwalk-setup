class Busy:
    """Background work for a page: run(work) in a thread, toast its message, then refresh."""

    def run(self, work, *args):
        self.busy = True

        def job():
            msg = work(*args)
            GLib.idle_add(self._done, msg)

        threading.Thread(target=job, daemon=True).start()

    def _done(self, msg):
        self.busy = False
        if msg:
            self.toasts.add_toast(Adw.Toast(title=msg, timeout=5))
        self.refresh()

    def clear(self):
        while (c := self.body.get_first_child()) is not None:
            self.body.remove(c)


