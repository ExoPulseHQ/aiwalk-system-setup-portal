OBSIDIAN_CONFIG = os.path.expanduser("~/.config/obsidian/obsidian.json")
VAULT_HOME = os.path.expanduser("~/Documents/aIwalk")


def obsidian_app():
    for app_id in ("obsidian.desktop", "md.obsidian.Obsidian.desktop"):
        if Gio.DesktopAppInfo.new(app_id):
            return app_id
    return None


def obsidian_vaults():
    import json
    try:
        return json.load(open(OBSIDIAN_CONFIG)).get("vaults", {})
    except (OSError, ValueError):
        return {}


def find_vault(repo):
    """Local copy of repo: a vault Obsidian knows whose git remote is repo, else the default folder."""
    paths = [v["path"] for v in obsidian_vaults().values()]
    paths.append(os.path.join(VAULT_HOME, repo.split("/")[1]))
    for path in paths:
        code, url = sh("git", "-C", path, "remote", "get-url", "origin", timeout=5)
        if code == 0 and url.rstrip("/").removesuffix(".git").endswith(repo):
            return path
    return None


def register_vault(path):
    """Adds path to Obsidian's vault list so it can be opened (Obsidian must not be running)."""
    import json
    import secrets
    try:
        config = json.load(open(OBSIDIAN_CONFIG))
    except (OSError, ValueError):
        config = {}
    vaults = config.setdefault("vaults", {})
    if not any(v["path"] == path for v in vaults.values()):
        vaults[secrets.token_hex(8)] = {"path": path, "ts": int(GLib.get_real_time() / 1000)}
        os.makedirs(os.path.dirname(OBSIDIAN_CONFIG), exist_ok=True)
        with open(OBSIDIAN_CONFIG, "w") as f:
            json.dump(config, f)


class VaultSection(Gtk.Box, Busy):
    """Part of the Team access page: download the team's Obsidian vaults and keep them up to date."""

    def __init__(self, toasts):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        self.toasts, self.busy = toasts, False
        self.body = self
        self.progress = {}
        self.extras, self.data = {}, None
        self.refresh()

    def set_extras(self, extras):
        """{repo: () -> [widgets]} shown when that vault's row is expanded."""
        self.extras = extras
        if self.data:
            self._show(*self.data)

    def refresh(self):
        if self.busy:
            return
        threading.Thread(target=lambda: GLib.idle_add(
            self._show, {repo: find_vault(repo) for _, repo, _ in VAULTS}, obsidian_app()), daemon=True).start()

    def _show(self, found, obsidian):
        self.data = (found, obsidian)
        self.clear()
        group = Adw.PreferencesGroup(title="Document vault",
                                     description="Opened with Obsidian. Expand a vault to see what each "
                                                 "account can open in it.")
        for name, repo, about in VAULTS:
            path = found[repo]
            subtitle = f"{about}\n" + (path or "Not downloaded yet")
            if repo in self.extras:
                row = Adw.ExpanderRow(title=name, subtitle=subtitle)
                for extra in self.extras[repo]():
                    row.add_row(extra)
            else:
                row = Adw.ActionRow(title=name, subtitle=subtitle)
            row.add_prefix(Gtk.Image(icon_name="folder-documents-symbolic"))
            if path:
                update = Gtk.Button(icon_name="emblem-synchronizing-symbolic", tooltip_text="Get the latest changes",
                                    valign=Gtk.Align.CENTER)
                update.add_css_class("flat")
                update.connect("clicked", lambda *_, p=path: self.run(self._update, p))
                row.add_suffix(update)
                open_ = Gtk.Button(label="Open", valign=Gtk.Align.CENTER, sensitive=bool(obsidian))
                open_.connect("clicked", lambda *_, p=path: self._open(p, obsidian))
                row.add_suffix(open_)
            else:
                bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER, visible=False, width_request=120)
                self.progress[repo] = bar
                row.add_suffix(bar)
                get = Gtk.Button(label="Download", valign=Gtk.Align.CENTER)
                get.add_css_class("suggested-action")
                get.connect("clicked", lambda b, r=repo: (b.set_visible(False), self.run(self._download, r)))
                row.add_suffix(get)
            group.add(row)
        self.body.append(group)
        if not obsidian:
            apps = Adw.PreferencesGroup()
            row = Adw.ActionRow(title="Obsidian is not installed", subtitle="Needed to read and edit the vault")
            row.add_prefix(Gtk.Image(icon_name="dialog-warning-symbolic"))
            install = Gtk.Button(label="Install", valign=Gtk.Align.CENTER)
            install.connect("clicked", lambda *_: self.run(self._install_obsidian))
            row.add_suffix(install)
            apps.add(row)
            self.body.append(apps)

    def _download(self, repo):
        import re
        dest = os.path.join(VAULT_HOME, repo.split("/")[1])
        os.makedirs(VAULT_HOME, exist_ok=True)
        bar = self.progress.get(repo)
        GLib.idle_add(bar.set_visible, True)
        # shallow: members need the current notes, not years of history
        proc = subprocess.Popen(["git", "-c", "credential.helper=", "-c", f"credential.helper={GH_HELPER}",
                                 "clone", "--progress", "--depth", "1", f"https://github.com/{repo}.git", dest],
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                                env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
        tail = ""
        for chunk in iter(lambda: proc.stdout.read(256), ""):
            tail = (tail + chunk)[-400:]
            m = re.findall(r"Receiving objects:\s+(\d+)%", tail)
            if m:
                GLib.idle_add(bar.set_fraction, int(m[-1]) / 100)
        if proc.wait() != 0:
            shutil.rmtree(dest, ignore_errors=True)
            if "not found" in tail or "Authentication" in tail or "could not read" in tail:
                return "No access to the vault. Sign in first, or ask an admin for access."
            return f"Download failed: {tail.strip().splitlines()[-1][:120] if tail.strip() else 'unknown error'}"
        sh("git", "-C", dest, "config", "credential.helper", GH_HELPER)
        register_vault(dest)
        return "Vault downloaded"

    @staticmethod
    def _update(path):
        code, out = sh("git", "-C", path, "pull", "--ff-only", timeout=300)
        if code == 0:
            return "Already up to date" if "Already up to date" in out else "Vault updated"
        return "Could not update: your copy has local changes" if "local changes" in out or "diverg" in out \
            else f"Could not update: {out.splitlines()[-1][:120] if out else ''}"

    def _open(self, path, obsidian):
        from urllib.parse import quote
        register_vault(path)
        Gio.AppInfo.launch_default_for_uri(f"obsidian://open?path={quote(path)}", None)

    @staticmethod
    def _install_obsidian():
        code, out = sh("flatpak", "install", "-y", "--user", "flathub", "md.obsidian.Obsidian", timeout=900)
        return "Obsidian installed" if code == 0 else f"Could not install Obsidian: {out[-120:]}"


