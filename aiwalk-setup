    def _resources(self, vm):
        group = Adw.PreferencesGroup(title="Resources",
                                     description="Applied while Windows is off")
        apply = Gtk.Button(label="Apply", sensitive=False, valign=Gtk.Align.CENTER)
        apply.add_css_class("suggested-action")
        group.set_header_suffix(apply)
        host_gb = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") // 2**30
        now = {"RAM_SIZE": gb(vm.ram), "CPU_CORES": gb(vm.cpus), "DISK_SIZE": gb(vm.disk)}
        rows = {
            # leave the host at least 4 GB; the disk can only grow (Windows cannot shrink it)
            "RAM_SIZE": ("Memory (GB)", f"This computer has {host_gb} GB", 2, max(host_gb - 4, 2)),
            "CPU_CORES": ("CPU cores", f"This computer has {os.cpu_count()}", 1, os.cpu_count()),
            "DISK_SIZE": ("Disk size (GB)", "Can only grow", now["DISK_SIZE"] or 32, 1024),
        }
        spins = {}
        for key, (title, subtitle, lo, hi) in rows.items():
            spin = Adw.SpinRow.new_with_range(lo, hi, 1)
            spin.set_title(title)
            spin.set_subtitle(subtitle)
            spin.set_value(now[key] or lo)
            spin.connect("notify::value", lambda *_: apply.set_sensitive(
                any(int(s.get_value()) != now[k] for k, s in spins.items())))
            spins[key] = spin
            group.add(spin)
        apply.connect("clicked", lambda *_: self._apply_resources(
            {k: int(s.get_value()) for k, s in spins.items() if int(s.get_value()) != now[k]}))

        used = vm.disk_used_gb()
        space = Adw.ActionRow(title="Clean up space",
                              subtitle=(f"The disk takes {used:.0f} GB on this computer. " if used else "") +
                              "Removes Office and PowerPoint caches, crash dumps, temp files and "
                              "the recycle bin inside Windows, then gives the space back.")
        space.add_prefix(Gtk.Image(icon_name="user-trash-symbolic"))
        self.clean_row, self.clean_bar = space, Gtk.ProgressBar(valign=Gtk.Align.CENTER, width_request=140,
                                                                 visible=self.cleaning is not None)
        space.add_suffix(self.clean_bar)
        if self.cleaning is None:
            clean = Gtk.Button(label="Clean up", valign=Gtk.Align.CENTER)
            clean.connect("clicked", lambda *_: self._clean_up())
            space.add_suffix(clean)
        else:
            self._show_progress()
        group.add(space)
        return group

    def _apply_resources(self, changes):
        vm = self.vm
        values = {k: f"{v}G" if k != "CPU_CORES" else str(v) for k, v in changes.items()}

        def apply():
            if vm.running:
                stop_windows(vm)
            code, out = vm.set_env(values)
            if code != 0:
                return f"Could not apply: {out[-120:]}"
            if "DISK_SIZE" in changes:
                return ("Applied. To use the bigger disk, extend drive C: in Windows' "
                        "Disk Management after the next start.")
            return "Applied, used from the next start"

        if not vm.running:
            self.run(apply)
            return
        dialog = Adw.AlertDialog(heading="Shut down Windows first?",
                                 body="Memory, CPU and disk changes apply while the VM is off. "
                                      "Windows will shut down, then the change is applied.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("apply", "Shut down and apply")
        dialog.set_response_appearance("apply", Adw.ResponseAppearance.SUGGESTED)
        dialog.connect("response", lambda _d, r: self.run(apply) if r == "apply" else None)
        dialog.present(self)

    def _clean_up(self):
        """Runs the cleanup through the aIwalk helper in Windows; sets the helper up once if needed."""
        vm = self.vm
        if not vm.helper_dir():
            self.toasts.add_toast(Adw.Toast(title="This VM has no shared folder, so cleanup cannot run "
                                                  "automatically", timeout=5))
            return
        vm.stage_helper()
        self._clean_step("Starting Windows" if not vm.running else "Contacting Windows")
        self.run(self._clean_job, vm, not vm.running)

    # Rough share of the total time each step reported by cleanup.ps1 starts at; step 8 (DISM) is the long one.
    CLEAN_STEPS = {1: .02, 2: .04, 3: .06, 4: .08, 5: .10, 6: .13, 7: .16, 8: .20, 9: .85}

    def _clean_step(self, text):
        """Called from any thread with the current step; None when the cleanup is over."""
        def show():
            if text is None:
                self.cleaning = None
            else:
                if not self.cleaning or self.cleaning[0] != text:
                    self.cleaning = (text, time.time())
                self._show_progress()
        GLib.idle_add(show)

    def _show_progress(self):
        if self.clean_bar is None:
            return
        text, since = self.cleaning
        step = int(text[0]) if text[:1].isdigit() else 0
        start = self.CLEAN_STEPS.get(step, 0)
        end = self.CLEAN_STEPS.get(step + 1, 1)
        # creep towards the next step so the bar keeps moving during long steps
        fraction = start + (end - start) * (1 - math.exp(-(time.time() - since) / 240))
        self.clean_bar.set_fraction(fraction)
        self.clean_bar.set_visible(True)
        self.clean_row.set_subtitle(f"{text}… ({fraction:.0%})")

    def _tick_progress(self):
        if self.cleaning is not None:
            self._show_progress()
        return True

    def _clean_job(self, vm, starting):
        try:
            return self._clean_work(vm, starting)
        finally:
            self._clean_step(None)

    def _clean_work(self, vm, starting):
        if starting:
            code, out = sh("docker", "compose", "-f", vm.compose, "start", timeout=120)
            if code != 0:
                return f"Could not start Windows: {out[-120:]}"
        if not vm.wait_helper(240 if starting else 20):
            GLib.idle_add(self._set_up_helper, vm)
            return None
        return vm.run_job("cleanup", self._clean_step)

    def _after_setup(self, vm):
        self._clean_step("Waiting for the one-time setup in Windows")
        try:
            if not vm.wait_helper(900):
                return "The aIwalk helper was not set up, try Clean up again"
            return vm.run_job("cleanup", self._clean_step)
        finally:
            self._clean_step(None)

    def _set_up_helper(self, vm):
        command = ("Start-Process powershell -Verb RunAs -ArgumentList "
                   "'-ExecutionPolicy Bypass -File \\\\host.lan\\Data\\.aiwalk\\install-agent.ps1'")
        dialog = Adw.AlertDialog(
            heading="One-time setup",
            body="Windows needs the small aIwalk helper to clean up by itself.\n\n"
                 "1. Windows opens and the setup command is copied.\n"
                 "2. In Windows, right-click Start, choose Terminal, press Ctrl+V and Enter.\n"
                 "3. Answer Yes when Windows asks for permission.\n\n"
                 "The cleanup then starts on its own. Next time, Clean up needs no steps.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Open Windows and copy command")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, response):
            if response != "go":
                return
            self.get_display().get_clipboard().set(command)
            self._open()
            # the helper reports in once it is installed; then clean up
            threading.Thread(target=lambda: GLib.idle_add(
                self._done, self._after_setup(vm)), daemon=True).start()

        dialog.connect("response", answered)
        dialog.present(self)

    # ---------- actions ----------

    def _toggle_card(self, on):
        vm = self.vm
        if vm is None or on == vm.card_reader:
            return
        if vm.running:
            dialog = Adw.AlertDialog(heading="Shut down Windows first?",
                                     body="The card reader setting applies to the VM while it is off. "
                                          "Windows will shut down, then the change is applied.")
            dialog.add_response("cancel", "Cancel")
            dialog.add_response("apply", "Shut down and apply")
            dialog.set_response_appearance("apply", Adw.ResponseAppearance.SUGGESTED)

            def answered(_d, response):
                if response == "apply":
                    self.run(lambda: (self._stop(), self._apply_card(on))[1])
                else:
                    self._done(None)

            dialog.connect("response", answered)
            dialog.present(self)
        else:
            self.run(self._apply_card, on)

    def _apply_card(self, on):
        code, out = self.vm.set_card_reader(on)
        if code != 0:
            return f"Could not apply the card reader setting: {out[-120:]}"
        return "Card reader passthrough is " + ("on" if on else "off")

    def _stop(self):
        return stop_windows(self.vm)

    def _ask_password(self, user, then, reason=None):
        entry = Gtk.PasswordEntry(show_peek_icon=True, activates_default=True)
        dialog = Adw.AlertDialog(heading=f"Password for {user}",
                                 body=(reason + "\n\n" if reason else "") +
                                 "Saved in this computer's keyring, used to sign in to Windows.")
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("save", "Save")
        dialog.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("save")

        def answered(_d, response):
            if response == "save" and entry.get_text():
                save_password(user, entry.get_text())
                if then:
                    then()

        dialog.connect("response", answered)
        dialog.present(self)

    def _open(self):
        vm = self.vm
        password = load_password(vm.user)
        if not password:
            self._ask_password(vm.user, self._open)
            return
        self.toasts.add_toast(Adw.Toast(title="Opening Windows…" if vm.running
                                        else "Starting Windows, this takes 1–2 minutes…", timeout=5))
        self.run(self._connect, vm, password)

    def _connect(self, vm, password):
        result = connect_windows(vm, password)
        if result == WRONG_PASSWORD:
            GLib.idle_add(self._ask_password, vm.user, self._open,
                          "Windows rejected this password. Enter the password of the Windows account.")
            return None
        return result

    # ---------- desktop shortcuts ----------

    def _toggle_shortcut(self, key, on):
        set_shortcut(key, on)
        self.toasts.add_toast(Adw.Toast(title=("Added" if on else "Removed") +
                                        f" the {SHORTCUTS[key][0]} shortcut", timeout=3))


WRONG_PASSWORD = "wrong-password"
DRIVES_FILE = os.path.expanduser("~/.config/aiwalk-setup/drives")  # extra folders for Windows, name=path


def gb(text):
    """'6G' -> 6, '4' -> 4, anything else -> 0."""
    digits = "".join(c for c in str(text) if c.isdigit())
    return int(digits) if digits else 0


def connect_windows(vm, password):
    """Starts the VM if needed and opens its desktop. Returns None when Windows is on screen."""
    if not vm.running:
        code, out = sh("docker", "compose", "-f", vm.compose, "start", timeout=120)
        if code != 0:
            return f"Could not start Windows: {out[-120:]}"
    # Windows drops the connection until it has booted; retry for about 3 minutes.
    for _ in range(18):
        rdp = subprocess.Popen(
            ["flatpak", "run", "--command=sdl-freerdp", "com.freerdp.FreeRDP", "/cert:ignore",
             "+home-drive", *vm.drives(), "+clipboard", f"/u:{vm.user}", f"/p:{password}", "/scale:100",
             "/dynamic-resolution", f"/v:127.0.0.1:{vm.rdp_port}"],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
        try:
            out, _ = rdp.communicate(timeout=7)
        except subprocess.TimeoutExpired:
            threading.Thread(target=rdp.communicate, daemon=True).start()  # keep draining its log
            return None  # still connected: Windows is on screen
        # Never retry a sign-in Windows refused: repeated wrong passwords lock the account.
        if "ACCOUNT_LOCKED_OUT" in out:
            return ("Windows locked this account after too many wrong passwords. "
                    "Wait about 10 minutes, then open Windows again.")
        if "LOGON_FAILURE" in out or "WRONG_PASSWORD" in out or "PASSWORD_EXPIRED" in out:
            return WRONG_PASSWORD
        GLib.usleep(8_000_000)
    return "Windows did not answer in time, try Open Windows again"


def stop_windows(vm):
    code, out = sh("docker", "compose", "-f", vm.compose, "stop", timeout=180)
    return "Windows is shut down" if code == 0 else f"Could not shut down Windows: {out[-120:]}"


# Desktop / app-menu shortcuts: key -> (name, comment, icon file, command-line flag)
SHORTCUTS = {
    "open": ("Open Windows", "Start the Windows VM and open its desktop", "windows-open", "--windows-open"),
    "stop": ("Shut down Windows", "Shut down the Windows VM and free its memory", "windows-stop", "--windows-stop"),
}


def _shortcut_paths(key):
    desktop_dir = subprocess.run(["xdg-user-dir", "DESKTOP"], capture_output=True, text=True).stdout.strip() \
        or os.path.join(HOME, "Desktop")
    name = f"{APP_ID}.{key}.desktop"
    return (os.path.join(HOME, ".local/share/applications", name), os.path.join(desktop_dir, name),
            os.path.join(HOME, ".local/share/icons/hicolor/scalable/apps", f"{APP_ID}.{SHORTCUTS[key][2]}.svg"))


def has_shortcut(key):
    return os.path.exists(_shortcut_paths(key)[0])


def set_shortcut(key, on):
    menu, desktop, icon = _shortcut_paths(key)
    name, comment, icon_file, flag = SHORTCUTS[key]
    if not on:
        for f in (menu, desktop):
            if os.path.exists(f):
                os.remove(f)
        return
    os.makedirs(os.path.dirname(icon), exist_ok=True)
    shutil.copy(os.path.join(HERE, "icons", icon_file + ".svg"), icon)
    entry = (f"[Desktop Entry]\nName={name}\nComment={comment}\n"
             f"Exec={os.path.realpath(__file__)} {flag}\nIcon={APP_ID}.{icon_file}\n"
             "Terminal=false\nType=Application\nCategories=Utility;\n")
    for f in (menu, desktop):
        os.makedirs(os.path.dirname(f), exist_ok=True)
        with open(f, "w") as out:
            out.write(entry)
        os.chmod(f, 0o755)
    subprocess.run(["gio", "set", desktop, "metadata::trusted", "true"], capture_output=True)
    subprocess.run(["gtk-update-icon-cache", "-f", "-t", os.path.join(HOME, ".local/share/icons/hicolor")],
                   capture_output=True)


