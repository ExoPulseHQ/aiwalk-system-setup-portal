        if self.busy:
            return
        self.clear()
        self.body.append(Adw.Spinner() if hasattr(Adw, "Spinner") else Gtk.Spinner(spinning=True))
        self.vaults.refresh()
        threading.Thread(target=lambda: GLib.idle_add(self._show, *self._probe()), daemon=True).start()

    @staticmethod
