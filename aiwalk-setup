# ---------------------------------------------------------------- access tree

# A vault that is split into repos says so in its own routing file: which repo owns which folder,
# and the GitHub organisation that grants them. Any vault with one gets an access tree.
RULES_PATHS = ["Project_Management/vault_rules.json", "vault_rules.json"]
PERM_RANK = {"ADMIN": 4, "MAINTAIN": 3, "WRITE": 2, "TRIAGE": 1, "READ": 1}
PERM_LABEL = {4: ("Admin", "perm-admin"), 3: ("Write", "perm-write"), 2: ("Write", "perm-write"),
              1: ("Read", "perm-read"), 0: ("No access", "perm-none")}
PURPLE = (0x8C / 255, 0x54 / 255, 0xD9 / 255)


def vault_repos(vault):
    """(org, book, [(repo, [routed folders])]) from the vault's routing file, or None when it has none."""
    import json
    for path in RULES_PATHS:
        code, out = sh("gh", "api", f"repos/{vault}/contents/{path}", "-H", "Accept: application/vnd.github.raw",
                       timeout=20)
        if code == 0:
            break
    else:
        return None
    rules = json.loads(out).get("repos")
    if not rules or not rules.get("org"):
        return None
    folders = {}
    for route in rules["routes"]:
        prefix = route["prefix"]
        entry = folders.setdefault(route["repo"], [])
        # folders as routed (Papers/Strategy_IP_Market/), or the file itself when only files are routed
        shown = prefix if prefix.endswith("/") else prefix.rsplit("/", 1)[-1]
        if not prefix.startswith(".") and shown not in entry:
            entry.append(shown)
    return rules["org"], rules["book"], [(r, f) for r, f in folders.items() if r != rules["book"]]


def build_tree(book, repos, repo_teams):
    """Groups the vault's repos by who GitHub grants them to: the whole team, only core, or a domain team."""
    groups = {"Layers": [], "Team shared": [], "Founders": []}
    for repo, folders in repos:
        layer = next((f.rstrip("/") for f in folders if re.match(r"L\d_", f)), None)
        title = layer.replace("_", " ") if layer else repo.removeprefix("exo-").capitalize()
        teams = repo_teams.get(repo, set()) - {"core"}
        group = "Team shared" if "members" in teams else "Layers" if teams or layer else "Founders"
        groups[group].append((title, repo, "  ".join(folders) or repo, []))
    about = {"Layers": "Detail repos, one per domain", "Team shared": "Everyone on the team",
             "Founders": "Core only"}
    return ("main", book, "Primary logs, guides and templates",
            [(g, None, about[g], sorted(items)) for g, items in groups.items() if items])


def org_access(org):
    """({login: (name, {repo: rank} or None for owners)}, {repo: {team slugs}}) for ExoPulseHQ."""
    import json
    code, out = sh("gh", "api", "graphql", "-f", "query={ organization(login:\"%s\") {"
                   " membersWithRole(first:100) { edges { role node { login name } } }"
                   " teams(first:50) { nodes { slug members(first:100) { nodes { login } }"
                   " repositories(first:50) { edges { permission node { name } } } } } } }" % org, timeout=20)
    if code != 0:
        return {}, {}
    org = json.loads(out)["data"]["organization"]
    people = {}
    for edge in org["membersWithRole"]["edges"]:
        login = edge["node"]["login"]
        # org owners are admins of every repo
        people[login] = (edge["node"]["name"] or login, {} if edge["role"] != "ADMIN" else None)
    repo_teams = {}
    for team in org["teams"]["nodes"]:
        for edge in team["repositories"]["edges"]:
            repo_teams.setdefault(edge["node"]["name"], set()).add(team["slug"])
        for member in team["members"]["nodes"]:
            grants = people.get(member["login"], (None, {}))[1]
            if grants is None:
                continue
            for edge in team["repositories"]["edges"]:
                repo = edge["node"]["name"]
                grants[repo] = max(grants.get(repo, 0), PERM_RANK.get(edge["permission"], 0))
    return people, repo_teams


def security_keys():
    """Names of plugged-in FIDO security keys (HID usage page 0xF1D0)."""
    names = []
    for dev in sorted(os.listdir("/sys/class/hidraw")):
        base = f"/sys/class/hidraw/{dev}/device"
        try:
            if open(f"{base}/report_descriptor", "rb").read(3) == b"\x06\xd0\xf1":
                uevent = open(f"{base}/uevent").read()
                names.append(next((l.split("=", 1)[1] for l in uevent.splitlines()
                                   if l.startswith("HID_NAME=")), "Security key"))
        except OSError:
            pass
    return names


SK_KEY = os.path.expanduser("~/.ssh/id_ecdsa_sk_aiwalk")  # private half is only a handle; the secret stays in the key


def fido_info():
    """(PIN is set, minimum PIN length) of the first plugged-in FIDO key, or None."""
    from fido2.hid import CtapHidDevice
    from fido2.ctap2 import Ctap2
    dev = next(CtapHidDevice.list_devices(), None)
    if dev is None:
        return None
    try:
        info = Ctap2(dev).info
        return bool(info.options.get("clientPin")), info.min_pin_length or 4
    finally:
        dev.close()


def fido_set_pin(pin):
    from fido2.hid import CtapHidDevice
    from fido2.ctap2 import Ctap2, ClientPin
    dev = next(CtapHidDevice.list_devices())
    try:
        ClientPin(Ctap2(dev)).set_pin(pin)
    finally:
        dev.close()


def create_key(user, pin):
    """Creates an ecdsa-sk SSH key on the security key (PIN + touch). Returns an error message, or None."""
    import tempfile
    if not os.path.exists(SK_KEY):
        with tempfile.TemporaryDirectory() as tmp:
            # ssh-keygen asks for the PIN through SSH_ASKPASS since there is no terminal
            askpass = os.path.join(tmp, "askpass")
            with open(askpass, "w") as f:
                f.write('#!/bin/sh\nprintf "%s\\n" "$AIWALK_PIN"\n')
            os.chmod(askpass, 0o700)
            env = {**os.environ, "SSH_ASKPASS": askpass, "SSH_ASKPASS_REQUIRE": "force", "AIWALK_PIN": pin,
                   "DISPLAY": os.environ.get("DISPLAY", ":0")}
            os.makedirs(os.path.dirname(SK_KEY), mode=0o700, exist_ok=True)
            r = subprocess.run(["ssh-keygen", "-t", "ecdsa-sk", "-O", "resident", "-O", "verify-required",
                                "-O", "application=ssh:aiwalk", "-C", f"{user} aIwalk security key",
                                "-N", "", "-f", SK_KEY], env=env, stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, timeout=90)
            if r.returncode != 0:
                out = (r.stdout + r.stderr).strip()
                if "PIN" in out and ("incorrect" in out or "invalid" in out.lower()):
                    return "Wrong PIN"
                return "The key did not create a login key: " + (out.splitlines()[-1] if out else "no answer")
    return None


def register_key():
    """Registers the key's SSH key on GitHub through gh, for sign-in and commit signing, and has gh
    use SSH for git. Returns the message to show."""
    import socket
    title = f"aIwalk security key ({socket.gethostname()})"
    for kind in ("authentication", "signing"):
        code, out = sh("gh", "ssh-key", "add", SK_KEY + ".pub", "--title", title, "--type", kind, timeout=30)
        if code != 0 and "already" not in out:
            return f"Could not register the key on GitHub: {out[-120:]}"
    sh("gh", "config", "set", "--host", "github.com", "git_protocol", "ssh")
    return "Security key set up and registered on GitHub"


def account_has_key_login():
    """True when the GitHub account has a security-key SSH key (sk-...) registered."""
    code, out = sh("gh", "api", "user/keys", "--jq", ".[].key", timeout=15)
    return code == 0 and any(k.startswith("sk-") for k in out.splitlines())


class TreeGutter(Gtk.DrawingArea):
    """The connector lines and dot to the left of one access-tree row."""
    STEP = 26

    def __init__(self, depth, lasts, has_children):
        super().__init__(content_width=self.STEP * (depth + 1), content_height=40)
        self.depth, self.lasts, self.has_children = depth, lasts, has_children
        self.set_draw_func(self._draw)

    def _draw(self, _area, cr, _w, h):
        x = lambda col: 12 + self.STEP * col
        mid = h / 2
        cr.set_line_width(1.5)
        cr.set_source_rgba(0.6, 0.6, 0.65, 0.55)
        # ancestors' lines that continue past this row
        for col in range(self.depth - 1):
            if not self.lasts[col + 1]:
                cr.move_to(x(col), 0)
                cr.line_to(x(col), h)
        if self.depth:
            col, r = self.depth - 1, 8
            cr.move_to(x(col), 0)
            cr.line_to(x(col), mid - r)
            cr.curve_to(x(col), mid, x(col), mid, x(col) + r, mid)
            cr.line_to(x(self.depth) - (7 if self.has_children else 0), mid)
            if not self.lasts[-1]:
                cr.move_to(x(col), mid - r)
                cr.line_to(x(col), h)
        cr.stroke()
        if self.has_children:
            cr.move_to(x(self.depth), mid)
            cr.line_to(x(self.depth), h)
            cr.stroke()
            radius = 8 if self.depth == 0 else 6
            cr.set_source_rgba(*PURPLE, 0.35)
            cr.arc(x(self.depth), mid, radius + 3, 0, 2 * math.pi)
            cr.fill()
            cr.set_source_rgb(*PURPLE)
            cr.arc(x(self.depth), mid, radius, 0, 2 * math.pi)
            cr.fill()


def access_tree(tree, grants, org):
    """A split vault as a tree of repos, each with the permission `grants` gives (None = admin)."""
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    box.add_css_class("access-tree")

    def add(node, depth, lasts):
        title, repo, detail, children = node
        row = Gtk.Box(spacing=10)
        row.append(TreeGutter(depth, lasts, bool(children)))
        name = Gtk.Label(label=title, xalign=0)
        name.add_css_class("tree-group" if children else "tree-leaf")
        row.append(name)
        where = Gtk.Label(label=detail, xalign=0, hexpand=True, ellipsize=3)
        where.add_css_class("dim-label")
        where.add_css_class("monospace" if "/" in detail and not children else "caption")
        row.append(where)
        if repo:
            rank = 4 if grants is None else grants.get(repo, 0)
            text, css = PERM_LABEL[rank]
            pill = Gtk.Label(label=text, valign=Gtk.Align.CENTER, width_chars=9)
            pill.add_css_class("perm")
            pill.add_css_class(css)
            pill.set_tooltip_text(f"{org}/{repo}")
            row.append(pill)
        box.append(row)
        for i, child in enumerate(children):
            add(child, depth + 1, lasts + [i == len(children) - 1])

    add(tree, 0, [True])
    return box


