                people, repo_teams = orgs.setdefault(org, org_access(org))
                vaults[vault] = {"org": org, "people": people, "tree": build_tree(book, repos, repo_teams)}
        return user, {"vaults": vaults, "keys": security_keys(), "key_login": account_has_key_login(),
