diff --git a/src/led/led.c b/src/led/led.c
index 145cafb..72078bf 100644
--- a/src/led/led.c
+++ b/src/led/led.c
@@ -34,8 +34,28 @@ static volatile uint8_t blink_color = LED_COLOR_GREEN;
 static volatile uint32_t blink_on_ms = 0;
 static volatile uint32_t blink_off_ms = 0;
 
+/* the colour of the idle (mounted) breathing: white while sealed notes are locked, green once the host unlocked them */
+static uint8_t idle_color = LED_COLOR_WHITE;
+
+/* idle means mounted, or the smartcard interface powered off (MODE_SUSPENDED, blue): the computer's card service does
+   that after every look, which turned the light blue over the lock state; both show the lock state instead */
+static uint32_t with_idle_color(uint32_t mode) {
+    if (mode != MODE_MOUNTED && mode != MODE_SUSPENDED) {
+        return mode;
+    }
+    return ((uint32_t)MODE_MOUNTED & ~LED_COLOR_MASK) | ((uint32_t)idle_color << LED_COLOR_SHIFT);
+}
+
 void led_set_mode(uint32_t mode) {
-    led_mode = mode;
+    led_mode = with_idle_color(mode);
+}
+
+void led_set_idle_color(uint8_t color) {
+    bool idle = led_mode == with_idle_color(MODE_MOUNTED);
+    idle_color = color;
+    if (idle) {
+        led_mode = with_idle_color(MODE_MOUNTED);
+    }
 }
 
 uint32_t led_get_mode(void) {
