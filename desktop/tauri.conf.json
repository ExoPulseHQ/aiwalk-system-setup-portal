{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aIwalk System Setup",
  "identifier": "com.aiwalk.setup",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "aIwalk System Setup", "width": 980, "height": 720 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": ["deb", "appimage"], "icon": ["../icon.png"] }
}
